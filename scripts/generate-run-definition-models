#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
from textwrap import dedent

ROOT = Path(__file__).resolve().parent.parent
SCHEMA = ROOT / "sdk/src/skywright/_run_definition_resources/schema.json"
JAVA = (
    ROOT
    / "backend/src/main/java/de/zorro909/skywright/backend/rundefinition/RunDefinition.java"
)
PYTHON = ROOT / "sdk/src/skywright/_run_definition.py"


def outputs() -> dict[Path, str]:
    schema = json.loads(SCHEMA.read_text())
    version = schema["properties"]["schemaVersion"]["const"]
    if schema.get("type") != "object" or version != 2:
        raise SystemExit("unsupported Run Definition schema shape or version")
    java = dedent(
        f"""\
        // Generated by scripts/generate-run-definition-models from {SCHEMA.relative_to(ROOT)}. Do not edit.
        package de.zorro909.skywright.backend.rundefinition;

        import javax.annotation.processing.Generated;
        import tools.jackson.databind.JsonNode;
        import tools.jackson.databind.node.ObjectNode;

        /** Immutable internal model supporting Run Definition schema versions 1 and {version}. */
        @Generated("scripts/generate-run-definition-models")
        public final class RunDefinition {{

        \tprivate final ObjectNode value;

        \tprivate RunDefinition(ObjectNode value) {{
        \t\tthis.value = value.deepCopy();
        \t}}

        \tpublic static RunDefinition decode(String document) {{
        \t\treturn new RunDefinition(RunDefinitionCodec.decode(document));
        \t}}

        \tpublic static RunDefinition from(JsonNode value) {{
        \t\treturn decode(value.toString());
        \t}}

        \tpublic ObjectNode value() {{
        \t\treturn this.value.deepCopy();
        \t}}

        \tpublic String manifestArtifactDigest() {{
        \t\treturn this.value.at("/trainingProjectVersion/manifestArtifactDigest").asText();
        \t}}

        \tpublic JsonNode configuration() {{
        \t\treturn this.value.path("configuration").deepCopy();
        \t}}

        \tpublic JsonNode datasetDefinition() {{
        \t\treturn this.value.path("datasetDefinition").deepCopy();
        \t}}

        \tpublic String encode() {{
        \t\treturn this.value.toString();
        \t}}

        \t@Override
        \tpublic boolean equals(Object other) {{
        \t\treturn other instanceof RunDefinition definition && this.value.equals(definition.value);
        \t}}

        \t@Override
        \tpublic int hashCode() {{
        \t\treturn this.value.hashCode();
        \t}}

        }}
        """
    )
    python = dedent(
        f'''\
        # Generated by scripts/generate-run-definition-models from {SCHEMA.relative_to(ROOT)}. Do not edit.
        from __future__ import annotations

        from dataclasses import dataclass
        from typing import Any

        from skywright._run_definition_codec import (
            RunDefinitionValidationError,
            copy_value,
            decode,
            encode,
            equal_values,
        )

        __all__ = ["RunDefinition", "RunDefinitionValidationError"]


        @dataclass(frozen=True, init=False, eq=False)
        class RunDefinition:
            """Immutable internal model supporting Run Definition schema versions 1 and {version}."""

            _value: dict[str, Any]

            @classmethod
            def decode(cls, document: str) -> RunDefinition:
                definition = object.__new__(cls)
                object.__setattr__(definition, "_value", decode(document))
                return definition

            def to_json(self) -> str:
                return encode(self._value)

            def value(self) -> dict[str, Any]:
                return copy_value(self._value)

            def __eq__(self, other: object) -> bool:
                return isinstance(other, RunDefinition) and equal_values(
                    self._value, other._value
                )

            def __hash__(self) -> int:
                raise TypeError("unhashable type: 'RunDefinition'")
        '''
    )
    return {JAVA: java, PYTHON: python}


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--check", action="store_true")
    arguments = parser.parse_args()
    stale: list[Path] = []
    for path, content in outputs().items():
        if arguments.check:
            if not path.exists() or path.read_text() != content:
                stale.append(path.relative_to(ROOT))
        else:
            path.write_text(content)
    if stale:
        raise SystemExit(
            "stale generated Run Definition models: " + ", ".join(map(str, stale))
        )


if __name__ == "__main__":
    main()
