#!/usr/bin/env python3
"""Skywright's versioned Linux quality-plan entry point."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.request
from collections.abc import Iterable
from dataclasses import dataclass
from datetime import date, datetime, timedelta, timezone
from pathlib import Path

REPOSITORY = Path(__file__).resolve().parent.parent
TOOLCHAIN = json.loads(
    (REPOSITORY / "quality" / "toolchain.json").read_text(encoding="utf-8")
)
LOCAL_CHECKS = ("java", "frontend", "sdk")
CHECKS = (*LOCAL_CHECKS, "security")
ALL_CHECKS = frozenset(CHECKS)
CATEGORY_CHECKS = {
    "api": frozenset(("java", "frontend", "security")),
    "backend": frozenset(("java", "security")),
    "documentation": frozenset(),
    "fixture": frozenset(("java", "sdk", "security")),
    "frontend": frozenset(("frontend", "security")),
    "profile": frozenset(("sdk", "security")),
    "sdk": frozenset(("sdk", "security")),
    "shared-tooling": ALL_CHECKS,
}
COMMANDS = {
    "java": (
        ("pnpm", "--dir", "frontend", "install", "--frozen-lockfile"),
        ("./mvnw", "--batch-mode", "-pl", "backend", "-am", "verify"),
    ),
    "frontend": (
        ("pnpm", "--dir", "frontend", "install", "--frozen-lockfile"),
        ("pnpm", "--dir", "frontend", "run", "verify"),
    ),
    "sdk": (("sdk/scripts/verify",),),
}


class PrerequisiteError(RuntimeError):
    """A required local quality-gate prerequisite is unavailable or unsupported."""


@dataclass(frozen=True)
class PlannedCheck:
    applicable: bool
    reason: str

    def as_json(self) -> dict[str, object]:
        return {"applicable": self.applicable, "reason": self.reason}


@dataclass(frozen=True)
class QualityPlan:
    changed_files: tuple[str, ...]
    categories: tuple[str, ...]
    checks: dict[str, PlannedCheck]
    version: int = 1

    def as_json(self) -> dict[str, object]:
        return {
            "version": self.version,
            "changed_files": list(self.changed_files),
            "categories": list(self.categories),
            "checks": {name: check.as_json() for name, check in self.checks.items()},
        }

    @classmethod
    def from_json(cls, serialized: str) -> QualityPlan:
        try:
            value = json.loads(serialized)
            if value["version"] != 1:
                raise ValueError
            return cls(
                version=value["version"],
                changed_files=tuple(value["changed_files"]),
                categories=tuple(value["categories"]),
                checks={
                    name: PlannedCheck(
                        applicable=check["applicable"], reason=check["reason"]
                    )
                    for name, check in value["checks"].items()
                },
            )
        except (json.JSONDecodeError, KeyError, TypeError, ValueError) as error:
            raise PrerequisiteError(
                "quality plan JSON does not match version 1"
            ) from error


def category_for(path: str) -> str:
    normalized = path.removeprefix("./")
    if (
        normalized.startswith(("docs/", ".github/ISSUE_TEMPLATE/"))
        or normalized
        in {
            "LICENSE",
            "THIRD-PARTY-NOTICES.md",
        }
        or ("/" not in normalized and normalized.endswith(".md"))
    ):
        return "documentation"
    if normalized.startswith("api/"):
        return "api"
    if normalized.startswith(("backend/", "backend-deployment/")):
        return "backend"
    if normalized.startswith("frontend/"):
        return "frontend"
    if normalized.startswith("sdk/"):
        return "sdk"
    if normalized.startswith(("fixtures/", "conformance/")):
        return "fixture"
    if normalized.startswith(("environment-profiles/", "profiles/")):
        return "profile"
    return "shared-tooling"


def changed_files(base: str, head: str) -> list[str]:
    completed = subprocess.run(
        ("git", "diff", "--name-only", "--diff-filter=ACDMRTUXB", f"{base}...{head}"),
        cwd=REPOSITORY,
        check=True,
        capture_output=True,
        text=True,
    )
    return [line for line in completed.stdout.splitlines() if line]


def make_plan(paths: Iterable[str]) -> QualityPlan:
    materialized_paths = sorted(set(paths))
    categories = sorted({category_for(path) for path in materialized_paths})
    applicable = (
        ALL_CHECKS
        if not materialized_paths
        else frozenset().union(*(CATEGORY_CHECKS[category] for category in categories))
    )
    return QualityPlan(
        changed_files=tuple(materialized_paths),
        categories=tuple(categories or ["complete"]),
        checks={
            check: PlannedCheck(
                applicable=check in applicable,
                reason=(
                    "required by the selected change categories"
                    if check in applicable
                    else "irrelevant to the selected change categories"
                ),
            )
            for check in CHECKS
        },
    )


def plan_command(arguments: argparse.Namespace) -> int:
    paths = arguments.changed_file
    if arguments.base:
        paths = [*paths, *changed_files(arguments.base, arguments.head)]
    plan = make_plan(paths)
    serialized = json.dumps(plan.as_json(), separators=(",", ":"), sort_keys=True)
    if arguments.github_output:
        with Path(arguments.github_output).open("a", encoding="utf-8") as output:
            output.write(f"plan={serialized}\n")
            output.writelines(
                f"{name}={str(check.applicable).lower()}\n"
                for name, check in plan.checks.items()
            )
            output.writelines(f"{name}={value}\n" for name, value in TOOLCHAIN.items())
    if arguments.format == "json":
        print(serialized)
    else:
        print_plan(plan)
    return 0


def print_plan(plan: QualityPlan) -> None:
    print(f"Quality plan v{plan.version}: {', '.join(plan.categories)}")
    for name, check in plan.checks.items():
        disposition = "APPLICABLE" if check.applicable else "INAPPLICABLE"
        print(f"{disposition:12} {name}: {check.reason}")


def aggregate_command(arguments: argparse.Namespace) -> int:
    plan = QualityPlan.from_json(arguments.plan)
    results = dict(result.split("=", maxsplit=1) for result in arguments.result)
    failed = False
    for check, details in plan.checks.items():
        outcome = results.get(check, "missing")
        if details.applicable:
            if outcome == "success":
                print(f"PASSED {check}")
            else:
                failed = True
                print(f"FAILED {check} ({outcome})")
        else:
            print(f"INAPPLICABLE {check} ({outcome})")
    return 1 if failed else 0


def executable(name: str) -> str:
    resolved = shutil.which(name)
    if resolved is None:
        raise PrerequisiteError(f"required executable '{name}' is unavailable")
    return resolved


def output_of(*command: str, stderr: bool = False) -> str:
    completed = subprocess.run(
        command,
        cwd=REPOSITORY,
        check=True,
        capture_output=True,
        text=True,
    )
    return completed.stderr if stderr else completed.stdout


def require_java() -> None:
    java = executable("java")
    details = output_of(java, "-XshowSettings:properties", "-version", stderr=True)
    required = {
        "java.version": TOOLCHAIN["java_version"],
        "java.vendor": TOOLCHAIN["java_vendor"],
    }
    for property_name, expected in required.items():
        match = re.search(
            rf"^\s*{re.escape(property_name)} = (.+)$", details, re.MULTILINE
        )
        actual = match.group(1).strip() if match else "unknown"
        if actual != expected:
            raise PrerequisiteError(
                f"requires {property_name} {expected}; received {actual}"
            )
    runtime_match = re.search(
        r"^\s*java.runtime.version = (.+)$", details, re.MULTILINE
    )
    runtime = runtime_match.group(1).strip() if runtime_match else "unknown"
    if not runtime.startswith(TOOLCHAIN["java_runtime_prefix"]):
        raise PrerequisiteError(
            "requires GraalVM Community runtime "
            f"{TOOLCHAIN['java_runtime_prefix']}; received {runtime}"
        )

    maven = output_of(str(REPOSITORY / "mvnw"), "--version")
    if f"Apache Maven {TOOLCHAIN['maven_version']}" not in maven:
        first_line = maven.splitlines()[0] if maven else "unknown"
        raise PrerequisiteError(
            f"requires Maven Wrapper {TOOLCHAIN['maven_version']}; received {first_line}"
        )


def require_frontend() -> None:
    node = executable("node")
    pnpm = executable("pnpm")
    node_version = output_of(node, "--version").strip().removeprefix("v")
    if node_version != TOOLCHAIN["node_version"]:
        raise PrerequisiteError(
            f"requires Node {TOOLCHAIN['node_version']}; received Node {node_version or 'unknown'}"
        )
    pnpm_version = output_of(pnpm, "--version").strip()
    if pnpm_version != TOOLCHAIN["pnpm_version"]:
        raise PrerequisiteError(
            f"requires pnpm {TOOLCHAIN['pnpm_version']}; received pnpm {pnpm_version or 'unknown'}"
        )


def require_uv() -> None:
    uv = executable("uv")
    version = output_of(uv, "--version").strip()
    expected = f"uv {TOOLCHAIN['uv_version']}"
    if version != expected:
        raise PrerequisiteError(f"requires {expected}; received {version or 'unknown'}")


def require_browser() -> None:
    pnpm = executable("pnpm")
    try:
        browser_path = output_of(
            pnpm,
            "--dir",
            "frontend",
            "exec",
            "node",
            "--input-type=module",
            "--eval",
            "import { chromium } from '@playwright/test'; console.log(chromium.executablePath())",
        ).strip()
    except subprocess.CalledProcessError as error:
        raise PrerequisiteError(
            "required Playwright Chromium browser is unavailable; install frontend "
            "dependencies and run 'pnpm --dir frontend exec playwright install chromium'"
        ) from error
    if not browser_path or not Path(browser_path).is_file():
        raise PrerequisiteError(
            "required Playwright Chromium browser is unavailable; run "
            "'pnpm --dir frontend exec playwright install chromium'"
        )


def check_prerequisites(check: str) -> None:
    if check == "java":
        require_java()
        require_frontend()
    elif check == "frontend":
        require_frontend()
    elif check == "sdk":
        require_uv()


def run_command(arguments: argparse.Namespace) -> int:
    selected = set(arguments.check or LOCAL_CHECKS)
    unknown = selected.difference(LOCAL_CHECKS)
    if unknown:
        raise PrerequisiteError(f"unknown quality check: {', '.join(sorted(unknown))}")

    failed = False
    print("Quality plan v1: local verification")
    for check in CHECKS:
        if check == "security":
            print(
                "INAPPLICABLE security: enforced by GitHub dependency review, CodeQL, and secret scanning"
            )
            continue
        if check not in selected:
            print(f"INAPPLICABLE {check}: not selected")
            continue
        print(f"APPLICABLE {check}: selected for local verification")
        try:
            check_prerequisites(check)
            if check in {"java", "frontend"}:
                require_browser()
            if arguments.dry_run:
                print(f"PASSED {check}: prerequisites available (dry run)")
                continue
            commands = COMMANDS[check]
            for index, command in enumerate(commands):
                subprocess.run(
                    command, cwd=REPOSITORY, check=True, env=os.environ.copy()
                )
                if check in {"java", "frontend"} and index == 0:
                    require_browser()
            print(f"PASSED {check}")
        except (PrerequisiteError, subprocess.CalledProcessError) as error:
            failed = True
            if isinstance(error, subprocess.CalledProcessError):
                reason = f"native command exited {error.returncode}"
            else:
                reason = str(error)
            print(f"FAILED {check}: {reason}")
    return 1 if failed else 0


def identity_command(arguments: argparse.Namespace) -> int:
    if arguments.event == "tag":
        if not arguments.tag_commit:
            raise PrerequisiteError("tag identity requires the exact tag commit")
        if arguments.tested_revision != arguments.tag_commit:
            raise PrerequisiteError(
                "tested revision must equal the exact tag commit for a tag run"
            )
    identity = {
        "event": arguments.event,
        "tested_revision": arguments.tested_revision,
    }
    if arguments.head_revision:
        identity["head_revision"] = arguments.head_revision
    serialized = json.dumps(identity, separators=(",", ":"), sort_keys=True)
    if arguments.output:
        Path(arguments.output).write_text(f"{serialized}\n", encoding="utf-8")
    if arguments.format == "json":
        print(serialized)
    else:
        print(f"Tested revision: {identity['tested_revision']}")
        if arguments.head_revision:
            print(f"Head revision (diagnostic): {arguments.head_revision}")
    return 0


def load_suppressions(path: Path) -> list[dict[str, str]]:
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
        if document["version"] != 1 or not isinstance(document["suppressions"], list):
            raise ValueError
    except (OSError, json.JSONDecodeError, KeyError, TypeError, ValueError) as error:
        raise PrerequisiteError(
            f"invalid security suppression document: {path}"
        ) from error

    today = datetime.now(tz=timezone.utc).date()
    latest_expiry = today + timedelta(days=90)
    validated: list[dict[str, str]] = []
    required_fields = ("id", "manifest", "package_url", "issue", "expires", "reason")
    for index, candidate in enumerate(document["suppressions"]):
        if not isinstance(candidate, dict) or any(
            not isinstance(candidate.get(field), str) or not candidate[field].strip()
            for field in required_fields
        ):
            raise PrerequisiteError(
                f"suppression {index} requires non-empty {', '.join(required_fields)} fields"
            )
        suppression = {field: candidate[field].strip() for field in required_fields}
        if not re.fullmatch(
            r"GHSA-[23456789cfghjmpqrvwx]{4}-[23456789cfghjmpqrvwx]{4}-[23456789cfghjmpqrvwx]{4}",
            suppression["id"],
            re.IGNORECASE,
        ):
            raise PrerequisiteError(
                f"suppression {index} id must be one GHSA identifier"
            )
        if any(character in suppression["manifest"] for character in "*?"):
            raise PrerequisiteError(
                f"suppression {index} manifest must be one exact path"
            )
        if not suppression["package_url"].startswith("pkg:") or any(
            character in suppression["package_url"] for character in "*?"
        ):
            raise PrerequisiteError(
                f"suppression {index} package_url must be one exact unversioned package URL"
            )
        if not re.fullmatch(
            r"https://github\.com/Zorro909/skywright/issues/[1-9][0-9]*",
            suppression["issue"],
        ):
            raise PrerequisiteError(
                f"suppression {index} issue must link one skywright GitHub issue"
            )
        try:
            expiry = date.fromisoformat(suppression["expires"])
        except ValueError as error:
            raise PrerequisiteError(
                f"suppression {index} expires must be an ISO date"
            ) from error
        if expiry <= today or expiry > latest_expiry:
            raise PrerequisiteError(
                f"suppression {index} expires must be within the next 90 days"
            )
        validated.append(suppression)
    return validated


def security_policy_command(arguments: argparse.Namespace) -> int:
    suppressions = load_suppressions(Path(arguments.policy))
    suffix = "suppression" if len(suppressions) == 1 else "suppressions"
    print(f"Security policy: {len(suppressions)} valid {suffix}")
    return 0


def fetch_advisory(identifier: str) -> dict[str, object]:
    headers = {
        "Accept": "application/vnd.github+json",
        "User-Agent": "skywright-quality-gate",
        "X-GitHub-Api-Version": "2022-11-28",
    }
    token = os.environ.get("GITHUB_TOKEN")
    if token:
        headers["Authorization"] = f"Bearer {token}"
    request = urllib.request.Request(
        f"https://api.github.com/advisories/{identifier}", headers=headers
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.load(response)
    except (OSError, json.JSONDecodeError) as error:
        raise PrerequisiteError(f"could not resolve advisory {identifier}") from error


def dependency_has_fix(
    advisory: dict[str, object], ecosystem: str, package_name: str
) -> bool:
    return any(
        vulnerability.get("package", {}).get("ecosystem", "").lower()
        == ecosystem.lower()
        and vulnerability.get("package", {}).get("name") == package_name
        and vulnerability.get("first_patched_version") is not None
        for vulnerability in advisory.get("vulnerabilities", [])
    )


def dependency_policy_command(arguments: argparse.Namespace) -> int:
    try:
        changes = json.loads(arguments.changes or "[]")
        if not isinstance(changes, list):
            raise TypeError
    except (json.JSONDecodeError, TypeError) as error:
        raise PrerequisiteError("dependency changes must be a JSON array") from error
    suppressions = load_suppressions(Path(arguments.policy))
    advisory_cache = (
        json.loads(Path(arguments.advisories).read_text(encoding="utf-8"))
        if arguments.advisories
        else {}
    )
    if arguments.report:
        report = Path(arguments.report)
        report.parent.mkdir(parents=True, exist_ok=True)
        report.write_text(
            f"{json.dumps(changes, indent=2, sort_keys=True)}\n", encoding="utf-8"
        )

    blocked = False
    for change in changes:
        for vulnerability in change.get("vulnerabilities", []):
            severity = vulnerability.get("severity", "").lower()
            if severity not in {"high", "critical"}:
                continue
            identifier = vulnerability.get("advisory_ghsa_id", "")
            package_url = change.get("package_url", "")
            suppressed = any(
                suppression["id"].lower() == identifier.lower()
                and suppression["manifest"] == change.get("manifest")
                and (
                    package_url == suppression["package_url"]
                    or package_url.startswith(f"{suppression['package_url']}@")
                )
                for suppression in suppressions
            )
            if suppressed:
                print(f"SUPPRESSED {identifier} ({change.get('name')})")
                continue
            advisory = advisory_cache.get(identifier) or fetch_advisory(identifier)
            if dependency_has_fix(
                advisory, change.get("ecosystem", ""), change.get("name", "")
            ):
                blocked = True
                print(f"BLOCKED {identifier} ({severity}, available fix)")
            else:
                print(f"VISIBLE {identifier} (no available fix)")
    return 1 if blocked else 0


def parser() -> argparse.ArgumentParser:
    command_parser = argparse.ArgumentParser(description=__doc__)
    subcommands = command_parser.add_subparsers(dest="command")

    plan_parser = subcommands.add_parser("plan", help="plan checks for a change set")
    plan_parser.add_argument("--base", help="base revision for a three-dot git diff")
    plan_parser.add_argument(
        "--head", default="HEAD", help="head revision (default: HEAD)"
    )
    plan_parser.add_argument("--changed-file", action="append", default=[])
    plan_parser.add_argument("--format", choices=("text", "json"), default="text")
    plan_parser.add_argument("--github-output")
    plan_parser.set_defaults(handler=plan_command)

    aggregate_parser = subcommands.add_parser(
        "aggregate", help="evaluate observed CI outcomes against a plan"
    )
    aggregate_parser.add_argument("--plan", required=True)
    aggregate_parser.add_argument("--result", action="append", default=[])
    aggregate_parser.set_defaults(handler=aggregate_command)

    run_parser = subcommands.add_parser(
        "run", help="run the complete or selected local plan"
    )
    run_parser.add_argument("check", nargs="*", choices=LOCAL_CHECKS)
    run_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="validate prerequisites without running checks",
    )
    run_parser.set_defaults(handler=run_command)

    identity_parser = subcommands.add_parser(
        "identity", help="record the exact source revision under verification"
    )
    identity_parser.add_argument("--event", required=True)
    identity_parser.add_argument("--tested-revision", required=True)
    identity_parser.add_argument("--head-revision")
    identity_parser.add_argument("--tag-commit")
    identity_parser.add_argument("--format", choices=("text", "json"), default="text")
    identity_parser.add_argument("--output")
    identity_parser.set_defaults(handler=identity_command)

    policy_parser = subcommands.add_parser(
        "security-policy", help="validate narrow, issue-linked, expiring suppressions"
    )
    policy_parser.add_argument(
        "--policy", default=REPOSITORY / "security" / "suppressions.json"
    )
    policy_parser.set_defaults(handler=security_policy_command)

    dependency_parser = subcommands.add_parser(
        "dependency-policy", help="enforce fixable dependency vulnerability policy"
    )
    dependency_parser.add_argument("--changes", required=True)
    dependency_parser.add_argument(
        "--policy", default=REPOSITORY / "security" / "suppressions.json"
    )
    dependency_parser.add_argument("--advisories")
    dependency_parser.add_argument("--report")
    dependency_parser.set_defaults(handler=dependency_policy_command)
    return command_parser


def main() -> int:
    command_parser = parser()
    arguments = command_parser.parse_args()
    if not hasattr(arguments, "handler"):
        command_parser.print_help(sys.stderr)
        return 2
    try:
        return arguments.handler(arguments)
    except PrerequisiteError as error:
        command_parser.error(str(error))
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
