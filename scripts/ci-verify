#!/usr/bin/env python3
"""Stop obsolete PR verification without cancelling reusable native preparation."""

from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path


def current_source():
    event_path = os.environ.get("GITHUB_EVENT_PATH")
    if not event_path or os.environ.get("GITHUB_EVENT_NAME") != "pull_request":
        return lambda: True
    event = json.loads(Path(event_path).read_text())
    expected = event["pull_request"]["head"]["sha"]
    url = f"https://api.github.com/repos/{os.environ['GITHUB_REPOSITORY']}/pulls/{event['number']}"
    etag = None

    def check():
        nonlocal etag
        headers = {
            "Accept": "application/vnd.github+json",
            "Authorization": f"Bearer {os.environ['GH_TOKEN']}",
        }
        if etag:
            headers["If-None-Match"] = etag
        request = urllib.request.Request(url, headers=headers)
        for attempt in range(3):
            try:
                with urllib.request.urlopen(request, timeout=15) as response:
                    etag = response.headers.get("ETag")
                    return json.load(response)["head"]["sha"] == expected
            except urllib.error.HTTPError as error:
                if error.code == 304:
                    return True
                if error.code < 500:
                    raise
            except (TimeoutError, urllib.error.URLError):
                pass
            if attempt < 2:
                time.sleep(2)
        raise RuntimeError("Cannot verify PR source after three API attempts")

    return check


def stop(process, grace):
    # The command may exit before its children, so signal the whole session even then.
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    time.sleep(grace)
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    process.wait()


def supervise(command, check, *, interval=60, grace=5):
    if not check():
        print("Superseded PR revision; verification was not started.", flush=True)
        return 130
    process = subprocess.Popen(command, start_new_session=True)
    try:
        while True:
            try:
                return process.wait(timeout=interval)
            except subprocess.TimeoutExpired:
                if not check():
                    print(
                        "PR head changed; stopping obsolete verification and its children.",
                        flush=True,
                    )
                    stop(process, grace)
                    return 130
    finally:
        if process.poll() is None:
            stop(process, grace)


def main():
    command = sys.argv[1:]
    if command[:1] == ["--"]:
        command = command[1:]
    if not command:
        raise SystemExit("ci-verify requires a command")
    return supervise(command, current_source())


if __name__ == "__main__":
    raise SystemExit(main())
