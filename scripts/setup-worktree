#!/usr/bin/env bash
set -euo pipefail

repository="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repository"

for command in curl flock sha256sum install python3 tar; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "Required command is unavailable: $command" >&2
    exit 1
  fi
done

sdkman_directory="${SDKMAN_DIR:-${HOME}/.sdkman}"
nvm_directory="${NVM_DIR:-${HOME}/.nvm}"
if [[ ! -s "$sdkman_directory/bin/sdkman-init.sh" ]]; then
  echo "Install SDKMAN before running scripts/setup-worktree: https://sdkman.io/install" >&2
  exit 1
fi
if [[ ! -s "$nvm_directory/nvm.sh" ]]; then
  echo "Install NVM before running scripts/setup-worktree: https://github.com/nvm-sh/nvm" >&2
  exit 1
fi

lock_directory="${XDG_RUNTIME_DIR:-/tmp}"
exec 9>"${lock_directory}/skywright-toolchain-${UID}.lock"
flock 9

# Image qualification renders the production overlay without contacting a cluster.
# Reuse an installed kubectl; bootstrap a verified release on Linux when absent.
if ! command -v kubectl >/dev/null 2>&1; then
  case "$(uname -s)/$(uname -m)" in
    Linux/x86_64) kubectl_architecture=amd64 ;;
    Linux/aarch64) kubectl_architecture=arm64 ;;
    *) echo "Install kubectl before running scripts/setup-worktree on this platform" >&2; exit 1 ;;
  esac
  kubectl_version=v1.36.3
  kubectl_staging="$(mktemp -d "${lock_directory}/skywright-kubectl.XXXXXX")"
  trap 'rm -rf "$kubectl_staging"' EXIT
  kubectl_release="https://dl.k8s.io/release/${kubectl_version}/bin/linux/${kubectl_architecture}/kubectl"
  curl --fail --location --silent --show-error "$kubectl_release" --output "$kubectl_staging/kubectl"
  curl --fail --location --silent --show-error "${kubectl_release}.sha256" --output "$kubectl_staging/kubectl.sha256"
  (cd "$kubectl_staging" && printf '%s  kubectl\n' "$(cat kubectl.sha256)" | sha256sum --check --status)
  install -D -m 0755 "$kubectl_staging/kubectl" "${HOME}/.local/bin/kubectl"
  rm -rf "$kubectl_staging"
  trap - EXIT
  export PATH="${HOME}/.local/bin:${PATH}"
fi
kubectl version --client >/dev/null

sdkman_config="$sdkman_directory/etc/config"
if grep -q '^sdkman_auto_env=' "$sdkman_config"; then
  sed -i 's/^sdkman_auto_env=.*/sdkman_auto_env=true/' "$sdkman_config"
else
  printf '\nsdkman_auto_env=true\n' >> "$sdkman_config"
fi

# SDKMAN and NVM intentionally share candidates across every worktree.
# shellcheck disable=SC1090
set +u
cd "$lock_directory"
source "$sdkman_directory/bin/sdkman-init.sh"
cd "$repository"
if ! sdk env install; then
  java_candidate="$(sed -n 's/^java=//p' .sdkmanrc)"
  java_destination="$sdkman_directory/candidates/java/$java_candidate"
  if [[ "$(uname -s)/$(uname -m)" != Linux/x86_64 || -e "$java_destination" ]]; then
    exit 1
  fi
  # SDKMAN can list a new release before its download broker serves it. Use
  # the same checksum-pinned official archive as CI, registered with SDKMAN.
  mapfile -t java_archive_configuration < <(python3 - <<'PY'
import json
from pathlib import Path
toolchain = json.loads(Path("quality/toolchain.json").read_text())
print(toolchain["java_archive_url"])
print(toolchain["java_archive_sha256"])
PY
  )
  mkdir -p "$sdkman_directory/candidates/java"
  java_staging="$(mktemp -d "$sdkman_directory/candidates/java/.skywright.XXXXXX")"
  trap 'rm -rf "$java_staging"' EXIT
  curl --fail --location --silent --show-error --retry 3 \
    "${java_archive_configuration[0]}" --output "$java_staging/archive.tar.gz"
  printf '%s  %s\n' "${java_archive_configuration[1]}" "$java_staging/archive.tar.gz" \
    | sha256sum --check --strict
  mkdir "$java_staging/jdk"
  tar --extract --gzip --file "$java_staging/archive.tar.gz" \
    --strip-components=1 --directory "$java_staging/jdk"
  mv "$java_staging/jdk" "$java_destination"
  rm -rf "$java_staging"
  trap - EXIT
  sdk env install
fi
sdk env
while IFS='=' read -r candidate version; do
  [[ -n "$candidate" && -n "$version" ]] && sdk default "$candidate" "$version"
done < .sdkmanrc
set -u

# shellcheck disable=SC1090
set +u
source "$nvm_directory/nvm.sh"
nvm install
nvm use
nvm alias default "$(<.nvmrc)"
set -u

pnpm_version="$(node -p "require('./frontend/package.json').packageManager.replace('pnpm@', '')")"
if [[ "$(command -v pnpm >/dev/null 2>&1 && pnpm --version || true)" != "$pnpm_version" ]]; then
  npm install --global "pnpm@${pnpm_version}"
fi

uv_version="$(sed -n 's/^required-version = "==\([^"]*\)"/\1/p' sdk/pyproject.toml)"
if [[ -z "$uv_version" ]]; then
  echo "Could not read the required uv version from sdk/pyproject.toml" >&2
  exit 1
fi
if [[ "$(command -v uv >/dev/null 2>&1 && uv --version | awk '{print $2}' || true)" != "$uv_version" ]]; then
  curl -LsSf "https://astral.sh/uv/${uv_version}/install.sh" | sh
  export PATH="${HOME}/.local/bin:${PATH}"
fi

if ! uv python find 3.14 >/dev/null 2>&1; then
  uv python install 3.14
fi
pnpm --dir frontend install --frozen-lockfile
pnpm --dir frontend exec playwright install chromium

echo
echo "Skywright worktree is ready:"
java -version
mvn --version
printf 'Node %s\npnpm %s\n' "$(node --version)" "$(pnpm --version)"
uv --version
