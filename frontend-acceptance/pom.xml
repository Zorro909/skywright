<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.zorro909.skywright</groupId>
    <artifactId>skywright-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>skywright-web-acceptance</artifactId>
  <packaging>pom</packaging>
  <name>Skywright packaged web acceptance</name>
  <description>Runs the frontend-owned Playwright suite through the packaged Spring process.</description>

  <dependencies>
    <dependency>
      <groupId>de.zorro909.skywright</groupId>
      <artifactId>skywright-backend</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>stage-packaged-backend</id>
            <phase>pre-integration-test</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>de.zorro909.skywright</groupId>
                  <artifactId>skywright-backend</artifactId>
                  <version>${project.version}</version>
                  <outputDirectory>${project.build.directory}</outputDirectory>
                  <destFileName>application.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven.version}</version>
        <executions>
          <execution>
            <id>accept-packaged-web</id>
            <phase>integration-test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${skipITs}</skip>
              <workingDirectory>${maven.multiModuleProjectDirectory}/frontend</workingDirectory>
              <executable>pnpm</executable>
              <arguments><argument>run</argument><argument>test:acceptance</argument></arguments>
              <environmentVariables>
                <SKYWRIGHT_BACKEND_EXECUTABLE>${project.build.directory}/application.jar</SKYWRIGHT_BACKEND_EXECUTABLE>
              </environmentVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
