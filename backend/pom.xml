<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.zorro909.skywright</groupId>
    <artifactId>skywright-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>skywright-backend</artifactId>
  <name>Skywright backend</name>
  <description>Always-on Skywright control-plane backend.</description>

  <properties>
    <netty.version>4.2.16.Final</netty.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>de.zorro909.skywright</groupId>
      <artifactId>skywright-web</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>de.zorro909.skywright</groupId>
      <artifactId>skywright-api</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-liquibase</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${networknt-json-schema.version}</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>2.53.2</version>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache5-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>netty-nio-client</artifactId>
      <version>2.53.2</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
      <resource>
        <directory>${maven.multiModuleProjectDirectory}/sdk/src/skywright/_configuration_resources</directory>
        <targetPath>META-INF/skywright/configuration</targetPath>
        <filtering>false</filtering>
        <excludes>
          <exclude>**/__pycache__/**</exclude>
          <exclude>**/*.pyc</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${maven.multiModuleProjectDirectory}/sdk/src/skywright/_metric_resources</directory>
        <targetPath>META-INF/skywright/metrics</targetPath>
        <filtering>false</filtering>
        <excludes>
          <exclude>**/__pycache__/**</exclude>
          <exclude>**/*.pyc</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${maven.multiModuleProjectDirectory}/sdk/src/skywright/_run_definition_resources</directory>
        <targetPath>META-INF/skywright/run-definition</targetPath>
        <filtering>false</filtering>
        <excludes>
          <exclude>**/__pycache__/**</exclude>
          <exclude>**/*.pyc</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <version>${spring-boot.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-http-contract</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <includeArtifactIds>skywright-api</includeArtifactIds>
              <includeGroupIds>de.zorro909.skywright</includeGroupIds>
              <includes>META-INF/openapi/skywright-api.yaml</includes>
              <outputDirectory>${project.build.directory}/openapi-contract</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>generate-http-boundary</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.build.directory}/openapi-contract/META-INF/openapi/skywright-api.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <apiPackage>de.zorro909.skywright.backend.boundary.generated.api</apiPackage>
              <modelPackage>de.zorro909.skywright.backend.boundary.generated.model</modelPackage>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <typeMappings>
                <typeMapping>URI=String</typeMapping>
              </typeMappings>
              <globalProperties>
                <apis/>
                <models/>
                <apiDocs>false</apiDocs>
                <apiTests>false</apiTests>
                <modelDocs>false</modelDocs>
                <modelTests>false</modelTests>
                <supportingFiles>false</supportingFiles>
              </globalProperties>
              <configOptions>
                <annotationLibrary>none</annotationLibrary>
                <documentationProvider>none</documentationProvider>
                <interfaceOnly>true</interfaceOnly>
                <openApiNullable>false</openApiNullable>
                <requestMappingMode>api_interface</requestMappingMode>
                <skipDefaultInterface>true</skipDefaultInterface>
                <useJackson3>true</useJackson3>
                <useSpringBoot4>true</useSpringBoot4>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>package-http-contract</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/static/openapi</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.directory}/openapi-contract/META-INF/openapi</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <backend.executable>${project.build.directory}/${project.build.finalName}.jar</backend.executable>
            <postgresql.container.image>${postgresql.container.image}</postgresql.container.image>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>package-test-fixtures</id>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>de.zorro909.skywright</groupId>
              <artifactId>skywright-api</artifactId>
            </exclude>
          </excludes>
          <layers>
            <enabled>true</enabled>
          </layers>
        </configuration>
        <executions>
          <execution>
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
            <configuration>
              <additionalProperties>
                <sourceRevision>${git.commit.id.full}</sourceRevision>
              </additionalProperties>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
