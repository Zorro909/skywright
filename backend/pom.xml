<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.zorro909.skywright</groupId>
    <artifactId>skywright-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>skywright-backend</artifactId>
  <name>Skywright backend</name>
  <description>Always-on Skywright control-plane backend.</description>

  <dependencies>
    <dependency>
      <groupId>de.zorro909.skywright</groupId>
      <artifactId>skywright-api</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-configuration-processor</artifactId>
              <version>${spring-boot.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-http-contract</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <includeArtifactIds>skywright-api</includeArtifactIds>
              <includeGroupIds>de.zorro909.skywright</includeGroupIds>
              <includes>META-INF/openapi/skywright-api.yaml</includes>
              <outputDirectory>${project.build.directory}/openapi-contract</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <execution>
            <id>generate-http-boundary</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.build.directory}/openapi-contract/META-INF/openapi/skywright-api.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <apiPackage>de.zorro909.skywright.backend.boundary.generated.api</apiPackage>
              <modelPackage>de.zorro909.skywright.backend.boundary.generated.model</modelPackage>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <globalProperties>
                <apis/>
                <models/>
                <apiDocs>false</apiDocs>
                <apiTests>false</apiTests>
                <modelDocs>false</modelDocs>
                <modelTests>false</modelTests>
                <supportingFiles>false</supportingFiles>
              </globalProperties>
              <configOptions>
                <annotationLibrary>none</annotationLibrary>
                <documentationProvider>none</documentationProvider>
                <interfaceOnly>true</interfaceOnly>
                <openApiNullable>false</openApiNullable>
                <requestMappingMode>api_interface</requestMappingMode>
                <skipDefaultInterface>true</skipDefaultInterface>
                <useJackson3>true</useJackson3>
                <useSpringBoot4>true</useSpringBoot4>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>package-http-contract</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/static/openapi</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.directory}/openapi-contract/META-INF/openapi</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <backend.executable>${project.build.directory}/${project.build.finalName}.jar</backend.executable>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>de.zorro909.skywright</groupId>
              <artifactId>skywright-api</artifactId>
            </exclude>
          </excludes>
          <layers>
            <enabled>true</enabled>
          </layers>
        </configuration>
        <executions>
          <execution>
            <id>build-info</id>
            <goals>
              <goal>build-info</goal>
            </goals>
            <configuration>
              <additionalProperties>
                <sourceRevision>${git.commit.id.full}</sourceRevision>
              </additionalProperties>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
