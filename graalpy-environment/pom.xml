<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.zorro909.skywright</groupId>
    <artifactId>skywright-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>skywright-graalpy-environment</artifactId>
  <packaging>pom</packaging>
  <name>Skywright GraalPy environment</name>
  <description>Builds the locked, platform-specific Python environment embedded by Skywright.</description>

  <properties><graalpy.wheel.primer>false</graalpy.wheel.primer></properties>

  <dependencies>
    <dependency>
      <groupId>org.graalvm.polyglot</groupId>
      <artifactId>python</artifactId>
      <version>${graalpy.version}</version>
      <type>pom</type>
    </dependency>
    <dependency>
      <groupId>org.graalvm.python</groupId>
      <artifactId>python-embedding</artifactId>
      <version>${graalpy.version}</version>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>validate-prebuilt-graalpy-environment</id>
      <activation><property><name>graalpy.environment.prebuilt</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven.version}</version>
        <executions><execution><id>verify-native-identity</id><phase>validate</phase>
          <goals><goal>exec</goal></goals>
          <configuration>
            <skip>${graalpy.wheel.primer}</skip>
            <executable>python3</executable>
            <arguments>
              <argument>${maven.multiModuleProjectDirectory}/scripts/graalpy-environment</argument>
              <argument>verify</argument>
              <argument>--runtime-version</argument><argument>${graalpy.version}</argument>
              <argument>--skypilot-version</argument><argument>${skypilot.version}</argument>
            </arguments>
          </configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>build-graalpy-environment</id>
      <activation>
        <property>
          <name>!graalpy.environment.prebuilt</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.python</groupId>
            <artifactId>graalpy-maven-plugin</artifactId>
            <version>${graalpy.version}</version>
            <executions>
              <execution>
                <goals>
                  <goal>process-graalpy-resources</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <externalDirectory>${graalpy.external.directory}</externalDirectory>
              <graalPyLockFile>${project.basedir}/graalpy.lock</graalPyLockFile>
              <packages>
                <package>skypilot==${skypilot.version}</package>
                <!-- Keep native dependencies on the GraalPy-compatible versions qualified here. -->
                <package>numpy==2.2.4</package>
                <package>pandas==2.2.3</package>
                <package>psutil==5.9.8</package>
                <package>uvloop==0.19.0</package>
                <package>watchfiles==0.21.0</package>
              </packages>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>prime-graalpy-wheel-cache</id>
      <activation>
        <property>
          <name>graalpy.wheel.package</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.python</groupId>
            <artifactId>graalpy-maven-plugin</artifactId>
            <version>${graalpy.version}</version>
            <executions>
              <execution>
                <goals>
                  <goal>process-graalpy-resources</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <externalDirectory>${project.build.directory}/wheel-primer/${graalpy.wheel.id}</externalDirectory>
              <graalPyLockFile>${project.build.directory}/wheel-primer/${graalpy.wheel.id}.lock</graalPyLockFile>
              <packages>
                <package>${graalpy.wheel.package}</package>
                <package>numpy==2.2.4</package>
              </packages>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
