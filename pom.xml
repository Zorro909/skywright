<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>de.zorro909.skywright</groupId>
  <artifactId>skywright-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Skywright reactor</name>
  <description>Aggregator and shared build parent for Skywright project parts.</description>

  <modules>
    <module>backend</module>
  </modules>

  <properties>
    <java.version>25</java.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-toolchains-plugin</artifactId>
        <version>3.3.0</version>
        <executions>
          <execution>
            <id>select-supported-jdk</id>
            <goals>
              <goal>select-jdk-toolchain</goal>
            </goals>
            <configuration>
              <version>[25.0.4,25.0.5)</version>
              <runtimeVersion>25.0.4+7-jvmci-25.2-b20</runtimeVersion>
              <vendor>GraalVM Community</vendor>
              <useJdk>Never</useJdk>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-supported-build-runtime</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.16]</version>
                  <message>Build Skywright with the checked-in Maven Wrapper (Maven 3.9.16).</message>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[25.0.4,25.0.5)</version>
                  <message>Build Skywright with OpenJDK 25.0.4 from GraalVM Community 25.2.4.</message>
                </requireJavaVersion>
                <requireJavaVendor>
                  <includes>
                    <include>GraalVM Community</include>
                  </includes>
                  <message>Build Skywright with GraalVM Community 25.2.4.</message>
                </requireJavaVendor>
                <requireProperty>
                  <property>java.vendor.version</property>
                  <regex>GraalVM CE 25\.2\.4\+7\.1</regex>
                  <message>Build Skywright with GraalVM Community 25.2.4.</message>
                </requireProperty>
                <requireProperty>
                  <property>java.runtime.version</property>
                  <regex>25\.0\.4\+7-jvmci-25\.2-b20</regex>
                  <message>Build Skywright with the supported OpenJDK 25.0.4+7 runtime.</message>
                </requireProperty>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
