#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

mkdir -p target/test-results target/coverage

uv run --locked ruff format --check .
uv run --locked ruff check .
uv run --locked pyright
uv run --locked pyright --verifytypes skywright
scripts/generate-configuration-reference --check
../scripts/generate-run-definition-models --check
uv run --locked --group ml-test pytest \
  tests/test_configuration_contract.py tests/test_metric_contract.py tests/test_package.py \
  tests/test_release.py tests/test_training_process.py tests/test_run_store.py tests/test_run_definition.py \
  --junitxml target/test-results/unit.xml \
  --cov skywright \
  --cov-report xml:target/coverage/coverage.xml \
  --cov-report html:target/coverage/html
scripts/check-api-compatibility
