#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
mkdir -p target/test-results

coverage_arguments=()
if [[ "${1:-}" == '--coverage' ]]; then
  mkdir -p target/coverage
  coverage_arguments=(--cov skywright
    --cov-report xml:target/coverage/coverage.xml
    --cov-report html:target/coverage/html)
  shift
fi
if [[ "$#" -ne 0 ]]; then
  echo 'Usage: sdk/scripts/test-unit [--coverage]' >&2
  exit 2
fi

uv run --locked --group ml-test pytest tests/unit \
  --junitxml target/test-results/unit.xml "${coverage_arguments[@]}"
