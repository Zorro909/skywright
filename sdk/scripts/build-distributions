#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

artifact_directory="${1:-dist}"
mkdir -p "$artifact_directory"

if find "$artifact_directory" -maxdepth 1 -type f \
  \( -name 'skywright-*.whl' -o -name 'skywright-*.tar.gz' \) -print -quit | grep -q .; then
  echo "artifact directory already contains a Skywright distribution: $artifact_directory" >&2
  exit 2
fi

uv build --wheel --out-dir "$artifact_directory"
uv build --sdist --out-dir "$artifact_directory"
