{
  "name": "@skywright/web",
  "version": "0.1.0-SNAPSHOT",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "26.7.0",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "preflight": "node tools/preflight.mjs",
    "start": "pnpm run preflight && ng serve",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ng lint",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "test": "ng test --watch=false",
    "verify": "pnpm run preflight && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "build": "pnpm run preflight && ng build --configuration production",
    "build:maven": "pnpm run preflight && ng build --configuration maven",
    "test:acceptance": "pnpm run preflight && playwright test"
  },
  "dependencies": {
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/router": "22.1.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.62.1",
    "angular-eslint": "22.1.0",
    "axe-core": "4.13.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.0.8"
  }
}
