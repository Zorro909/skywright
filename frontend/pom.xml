<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.zorro909.skywright</groupId>
    <artifactId>skywright-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>skywright-web</artifactId>
  <name>Skywright web application</name>
  <description>Optimized client application packaged as Spring classpath web resources.</description>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven.version}</version>
        <executions>
          <execution>
            <id>validate-web-toolchain</id>
            <phase>validate</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>pnpm</executable>
              <arguments><argument>run</argument><argument>preflight</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>install-web-dependencies</id>
            <phase>generate-resources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>pnpm</executable>
              <arguments><argument>install</argument><argument>--frozen-lockfile</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-web</id>
            <phase>test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${skipTests}</skip>
              <executable>pnpm</executable>
              <arguments><argument>run</argument><argument>verify</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>check-web-format</id>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>pnpm</executable>
              <arguments><argument>run</argument><argument>format:check</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>format-web</id>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>pnpm</executable>
              <arguments><argument>run</argument><argument>format</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>lint-web</id>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>pnpm</executable>
              <arguments><argument>run</argument><argument>lint</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>typecheck-web</id>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>pnpm</executable>
              <arguments><argument>run</argument><argument>typecheck</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>test-web</id>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>pnpm</executable>
              <arguments><argument>run</argument><argument>test</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>build-web-artifact</id>
            <phase>prepare-package</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>pnpm</executable>
              <arguments><argument>run</argument><argument>build:maven</argument></arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>packaged-acceptance</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-maven.version}</version>
            <executions>
              <execution>
                <id>accept-packaged-web</id>
                <phase>integration-test</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <skip>${skipITs}</skip>
                  <executable>pnpm</executable>
                  <arguments><argument>run</argument><argument>test:acceptance</argument></arguments>
                  <environmentVariables>
                    <SKYWRIGHT_BACKEND_EXECUTABLE>${maven.multiModuleProjectDirectory}/backend/target/skywright-backend-${project.version}.jar</SKYWRIGHT_BACKEND_EXECUTABLE>
                  </environmentVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
