#!/usr/bin/env python3
"""Install or release one immutable local runtime pull secret using the SkyPilot role."""
import argparse
import base64
import json
import os
import stat
from pathlib import Path
import subprocess
import sys
import uuid


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("install", "release"))
    parser.add_argument("--run-id", required=True, type=uuid.UUID)
    parser.add_argument("--namespace", required=True)
    parser.add_argument("--context", required=True)
    parser.add_argument("--credential-file", type=Path)
    args = parser.parse_args()
    name = f"skywright-pull-{args.run_id}"
    command = ["kubectl", "--context", args.context, "--namespace", args.namespace]
    if args.action == "release":
        subprocess.run(command + ["delete", "secret", name, "--ignore-not-found"],
                       check=True, capture_output=True)
        return
    if args.credential_file is None:
        parser.error("install requires --credential-file")
    # The broker owns and removes the protected temporary file after this handoff.
    descriptor = os.open(args.credential_file, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(descriptor, "rb") as source:
        metadata = os.fstat(source.fileno())
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.geteuid()
                or stat.S_IMODE(metadata.st_mode) != 0o400 or metadata.st_size > 1024 * 1024):
            raise ValueError("Invalid runtime registry projection")
        content = source.read()
    value = json.loads(content)
    if not isinstance(value, dict) or set(value) != {"auths"} or set(value["auths"]) != {"ghcr.io"}:
        raise ValueError("Invalid runtime registry projection")
    secret = {"apiVersion": "v1", "kind": "Secret", "type": "kubernetes.io/dockerconfigjson",
              "immutable": True, "metadata": {"name": name, "namespace": args.namespace},
              "data": {".dockerconfigjson": base64.b64encode(content).decode("ascii")}}
    # create, never apply: a retry must not replace an existing Run's projection.
    subprocess.run(command + ["create", "-f", "-"], input=json.dumps(secret).encode(),
                   check=True, capture_output=True)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, TypeError, KeyError, subprocess.CalledProcessError):
        print("Local runtime pull projection failed", file=sys.stderr)
        raise SystemExit(1) from None
