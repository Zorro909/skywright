#!/usr/bin/env python3
"""Exercise the public local workflow against an existing Podman kind cluster."""

from __future__ import annotations

import argparse
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path


REPOSITORY = Path(__file__).resolve().parents[2]
MARKER = "skywright_deployment_system_marker"


def fail(message: str) -> None:
    raise SystemExit(f"deployment system-test prerequisite or assertion failed: {message}")


def command(*arguments: str, check: bool = True, input_text: str | None = None):
    return subprocess.run(
        arguments,
        cwd=REPOSITORY,
        check=check,
        input=input_text,
        capture_output=True,
        text=True,
    )


def kubectl(context: str, *arguments: str, check: bool = True):
    return command("kubectl", "--context", context, *arguments, check=check)


def require_prerequisites(context: str) -> None:
    for executable in ("git", "kind", "kubectl", "podman", "skaffold"):
        if shutil.which(executable) is None:
            fail(f"{executable} is not installed")
    try:
        version = command("skaffold", "version").stdout.strip()
    except subprocess.CalledProcessError as error:
        fail(f"cannot execute Skaffold: {error}")
    if version != "v2.24.0":
        fail(f"Skaffold v2.24.0 is required, got {version!r}")
    if command("kubectl", "config", "current-context").stdout.strip() != context:
        fail(f"{context!r} must be the active Kubernetes context")
    if not context.startswith("kind-"):
        fail("the context is not a kind context")


def wait_ready(process: subprocess.Popen[str], log: Path, timeout: float = 600) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if process.poll() is not None:
            diagnostics = log.read_text(encoding="utf-8", errors="replace")[-12000:]
            fail(
                f"local deployment exited before readiness with {process.returncode}\n"
                f"last deployment output:\n{diagnostics}"
            )
        try:
            with urllib.request.urlopen("http://127.0.0.1:8080/readyz", timeout=2) as response:
                if response.status == 200:
                    return
        except (OSError, urllib.error.URLError):
            pass
        time.sleep(2)
    fail("the backend did not become ready on the loopback port forward")


def start(context: str, log: Path) -> subprocess.Popen[str]:
    output = log.open("a", encoding="utf-8")
    process = subprocess.Popen(
        [str(REPOSITORY / "scripts" / "deploy"), "local", "--context", context],
        cwd=REPOSITORY,
        stdout=output,
        stderr=subprocess.STDOUT,
        text=True,
    )
    output.close()
    try:
        wait_ready(process, log)
    except BaseException:
        stop(process)
        raise
    return process


def stop(process: subprocess.Popen[str]) -> None:
    process.send_signal(signal.SIGTERM)
    try:
        process.wait(timeout=60)
    except subprocess.TimeoutExpired:
        process.kill()
        process.wait()
        fail("local deployment did not perform normal Skaffold cleanup after SIGTERM")
    if process.returncode != 0:
        fail(f"local deployment cleanup exited with {process.returncode}")


def uid(context: str, kind: str, name: str) -> str:
    return kubectl(
        context,
        "get",
        kind,
        name,
        "--namespace",
        "skywright",
        "--output",
        "jsonpath={.metadata.uid}",
    ).stdout


def marker(context: str, statement: str, check: bool = True):
    return kubectl(
        context,
        "exec",
        "--namespace",
        "skywright",
        "deployment/skywright-postgresql",
        "--",
        "psql",
        "--username",
        "postgres",
        "--dbname",
        "skywright",
        "--set=ON_ERROR_STOP=1",
        "--command",
        statement,
        check=check,
    )


def skypilot_state_marker(context: str, operation: str, check: bool = True):
    script = {
        "write": (
            "from pathlib import Path; "
            "Path('/var/lib/skypilot/system-test-marker').write_text('retained')"
        ),
        "read": (
            "from pathlib import Path; "
            "print(Path('/var/lib/skypilot/system-test-marker').read_text())"
        ),
    }[operation]
    return kubectl(
        context,
        "exec",
        "--namespace",
        "skywright",
        "deployment/skywright-skypilot-api-server",
        "--",
        "python",
        "-c",
        script,
        check=check,
    )


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--context", required=True)
    arguments = parser.parse_args()
    require_prerequisites(arguments.context)
    with tempfile.TemporaryDirectory(prefix="skywright-system-test-") as directory:
        log = Path(directory) / "deployment.log"
        unrelated = "skywright-deployment-system-unrelated"
        process = start(arguments.context, log)
        try:
            command(
                "kubectl",
                "--context",
                arguments.context,
                "apply",
                "--filename",
                "-",
                input_text=(
                    "apiVersion: v1\nkind: ConfigMap\nmetadata:\n"
                    f"  name: {unrelated}\n  namespace: skywright\n"
                ),
            )
            secret_uid = uid(arguments.context, "secret", "skywright-local-database")
            skypilot_secret_uid = uid(
                arguments.context,
                "secret",
                "skywright-local-skypilot-database",
            )
            volume_uid = uid(
                arguments.context,
                "persistentvolumeclaim",
                "skywright-postgresql-data",
            )
            skypilot_volume_uid = uid(
                arguments.context,
                "persistentvolumeclaim",
                "skywright-skypilot-state",
            )
            marker(
                arguments.context,
                f"CREATE TABLE public.{MARKER} (value integer NOT NULL); "
                f"INSERT INTO public.{MARKER} VALUES (82);",
            )
            skypilot_state_marker(arguments.context, "write")
            marker(
                arguments.context,
                "DROP DATABASE IF EXISTS skypilot WITH (FORCE); "
                "DROP ROLE IF EXISTS skypilot;",
            )
        finally:
            stop(process)
        if kubectl(
            arguments.context,
            "get",
            "deployment/skywright-backend",
            "--namespace",
            "skywright",
            check=False,
        ).returncode == 0:
            fail("normal Skaffold cleanup left the backend Deployment running")
        if kubectl(
            arguments.context,
            "get",
            "deployment/skywright-skypilot-api-server",
            "--namespace",
            "skywright",
            check=False,
        ).returncode == 0:
            fail("normal Skaffold cleanup left the SkyPilot Deployment running")
        if uid(arguments.context, "secret", "skywright-local-database") != secret_uid:
            fail("normal cleanup replaced local database credentials")
        if (
            uid(
                arguments.context,
                "secret",
                "skywright-local-skypilot-database",
            )
            != skypilot_secret_uid
        ):
            fail("normal cleanup replaced local SkyPilot database credentials")
        if uid(
            arguments.context,
            "persistentvolumeclaim",
            "skywright-postgresql-data",
        ) != volume_uid:
            fail("normal cleanup replaced the local database volume")
        if (
            uid(
                arguments.context,
                "persistentvolumeclaim",
                "skywright-skypilot-state",
            )
            != skypilot_volume_uid
        ):
            fail("normal cleanup replaced the local SkyPilot retained-state volume")

        process = start(arguments.context, log)
        try:
            if "82" not in marker(
                arguments.context, f"SELECT value FROM public.{MARKER};"
            ).stdout:
                fail("database state did not survive cleanup and restart")
            if "skypilot" not in marker(
                arguments.context,
                "SELECT datname FROM pg_database WHERE datname = 'skypilot';",
            ).stdout:
                fail("SkyPilot database was not provisioned into retained local PostgreSQL state")
            if "retained" not in skypilot_state_marker(
                arguments.context, "read"
            ).stdout:
                fail("SkyPilot volume state did not survive cleanup and restart")
        finally:
            stop(process)
        command(
            str(REPOSITORY / "scripts" / "deploy"),
            "reset-local-state",
            "--context",
            arguments.context,
            "--confirm",
            "reset skywright local control-plane state",
        )
        if kubectl(
            arguments.context,
            "get",
            "configmap",
            unrelated,
            "--namespace",
            "skywright",
            check=False,
        ).returncode != 0:
            fail("local state reset deleted an unrelated resource")
        process = start(arguments.context, log)
        try:
            if marker(
                arguments.context,
                f"SELECT value FROM public.{MARKER};",
                check=False,
            ).returncode == 0:
                fail("database reset retained the old database state")
            if skypilot_state_marker(
                arguments.context, "read", check=False
            ).returncode == 0:
                fail("local state reset retained the old SkyPilot volume state")
        finally:
            stop(process)
            kubectl(
                arguments.context,
                "delete",
                "configmap",
                unrelated,
                "--namespace",
                "skywright",
                check=False,
            )
        print("deployment system test passed")


if __name__ == "__main__":
    try:
        main()
    except subprocess.CalledProcessError as error:
        print(error.stderr, file=sys.stderr)
        fail(str(error))
