#!/usr/bin/env python3
"""Run deployment contract tests and emit a dependency-free JUnit report."""

from __future__ import annotations

import sys
import time
import unittest
import xml.etree.ElementTree as ET
from pathlib import Path
from typing import cast


class RecordingResult(unittest.TextTestResult):
    def __init__(self, *arguments, **keywords):
        super().__init__(*arguments, **keywords)
        self.successes: list[unittest.case.TestCase] = []

    def addSuccess(self, test: unittest.case.TestCase) -> None:
        self.successes.append(test)
        super().addSuccess(test)


def case_element(test: unittest.case.TestCase) -> ET.Element:
    identifier = test.id()
    class_name, _, name = identifier.rpartition(".")
    return ET.Element("testcase", classname=class_name, name=name)


repository = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(repository))
suite = unittest.defaultTestLoader.discover(str(repository / "tests" / "deployment"))
started = time.monotonic()
runner = unittest.TextTestRunner(verbosity=2, resultclass=RecordingResult)
result = cast(RecordingResult, runner.run(suite))
testsuite = ET.Element(
    "testsuite",
    name="deployment-contracts",
    tests=str(result.testsRun),
    failures=str(len(result.failures)),
    errors=str(len(result.errors)),
    skipped=str(len(result.skipped)),
    time=f"{time.monotonic() - started:.3f}",
)
for test in result.successes:
    testsuite.append(case_element(test))
for test, reason in result.skipped:
    case = case_element(test)
    ET.SubElement(case, "skipped", message=reason)
    testsuite.append(case)
for kind, records in (("failure", result.failures), ("error", result.errors)):
    for test, traceback in records:
        case = case_element(test)
        ET.SubElement(case, kind, message=traceback.splitlines()[-1]).text = traceback
        testsuite.append(case)
report = repository / "target" / "test-results" / "deployment.xml"
report.parent.mkdir(parents=True, exist_ok=True)
ET.ElementTree(testsuite).write(report, encoding="utf-8", xml_declaration=True)
raise SystemExit(not result.wasSuccessful())
