#!/usr/bin/env python3
"""Render the privileged authority for one explicitly enrolled local node."""

import argparse
import json
import re
import uuid

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--node", required=True)
parser.add_argument("--node-uid", required=True, type=uuid.UUID)
parser.add_argument("--image", required=True)
parser.add_argument(
    "--image-pull-policy",
    choices=("Never", "IfNotPresent", "Always"),
    default="IfNotPresent",
)
parser.add_argument("--namespace", default="skywright")
parser.add_argument("--training-namespace", default="skywright-training")
parser.add_argument("--name", default="skywright-local-writer")
parser.add_argument("--ancillary-render-device")
configuration = parser.parse_args()
for value in (
    configuration.node,
    configuration.namespace,
    configuration.training_namespace,
    configuration.name,
):
    if re.fullmatch(r"[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?", value) is None:
        parser.error("Names must be Kubernetes DNS names")
node, uid = configuration.node, str(configuration.node_uid)
ns, name = configuration.namespace, configuration.name
image, image_pull_policy = configuration.image, configuration.image_pull_policy
training_namespace = configuration.training_namespace
args = ["--node-name", node, "--node-uid", uid, "--namespace", training_namespace]
if configuration.ancillary_render_device is not None:
    if (
        re.fullmatch(r"/dev/dri/renderD[0-9]+", configuration.ancillary_render_device)
        is None
    ):
        parser.error("Ancillary device must name one qualified DRM render node")
    args += ["--ancillary-render-device", configuration.ancillary_render_device]
volumes = [
    {
        "name": "state",
        "hostPath": {"path": "/var/lib/skywright-writer", "type": "DirectoryOrCreate"},
    },
    {"name": "proc", "hostPath": {"path": "/proc", "type": "Directory"}},
    {"name": "cgroup", "hostPath": {"path": "/sys/fs/cgroup", "type": "Directory"}},
    {
        "name": "runtime",
        "hostPath": {"path": "/run/containerd/containerd.sock", "type": "Socket"},
    },
]
mounts = [
    {"name": "state", "mountPath": "/var/lib/skywright-writer"},
    {"name": "proc", "mountPath": "/host/proc", "readOnly": True},
    {"name": "cgroup", "mountPath": "/host/cgroup", "readOnly": True},
    {
        "name": "runtime",
        "mountPath": "/run/containerd/containerd.sock",
        "readOnly": True,
    },
]
common = {
    "image": image,
    "imagePullPolicy": image_pull_policy,
    "securityContext": {
        "privileged": False,
        "allowPrivilegeEscalation": False,
        "capabilities": {
            "drop": ["ALL"],
            "add": ["SYS_ADMIN", "SYS_PTRACE", "DAC_READ_SEARCH"],
        },
        "readOnlyRootFilesystem": True,
        "runAsUser": 0,
    },
    "volumeMounts": mounts,
    "resources": {
        "requests": {"cpu": "100m", "memory": "64Mi"},
        "limits": {"cpu": "1", "memory": "256Mi"},
    },
}
items = [
    {
        "apiVersion": "v1",
        "kind": "ServiceAccount",
        "metadata": {"name": name, "namespace": ns},
    },
    {
        "apiVersion": "rbac.authorization.k8s.io/v1",
        "kind": "ClusterRole",
        "metadata": {"name": name},
        "rules": [
            {
                "apiGroups": [""],
                "resources": ["nodes"],
                "resourceNames": [node],
                "verbs": ["get"],
            }
        ],
    },
    {
        "apiVersion": "rbac.authorization.k8s.io/v1",
        "kind": "ClusterRoleBinding",
        "metadata": {"name": name},
        "subjects": [{"kind": "ServiceAccount", "name": name, "namespace": ns}],
        "roleRef": {
            "apiGroup": "rbac.authorization.k8s.io",
            "kind": "ClusterRole",
            "name": name,
        },
    },
    {
        "apiVersion": "rbac.authorization.k8s.io/v1",
        "kind": "Role",
        "metadata": {"name": name, "namespace": training_namespace},
        "rules": [{"apiGroups": [""], "resources": ["pods"], "verbs": ["get"]}],
    },
    {
        "apiVersion": "rbac.authorization.k8s.io/v1",
        "kind": "RoleBinding",
        "metadata": {"name": name, "namespace": training_namespace},
        "subjects": [{"kind": "ServiceAccount", "name": name, "namespace": ns}],
        "roleRef": {
            "apiGroup": "rbac.authorization.k8s.io",
            "kind": "Role",
            "name": name,
        },
    },
    {
        "apiVersion": "apps/v1",
        "kind": "DaemonSet",
        "metadata": {"name": name, "namespace": ns},
        "spec": {
            "selector": {"matchLabels": {"app": name}},
            "template": {
                "metadata": {"labels": {"app": name}},
                "spec": {
                    "serviceAccountName": name,
                    "hostPID": True,
                    "nodeSelector": {"kubernetes.io/hostname": node},
                    "tolerations": [{"operator": "Exists"}],
                    "volumes": volumes,
                    "initContainers": [
                        dict(common, name="initialize", args=args + ["--initialize"])
                    ],
                    "containers": [
                        dict(
                            common,
                            name="authority",
                            args=args,
                            readinessProbe={
                                "exec": {
                                    "command": [
                                        "python3",
                                        "-m",
                                        "local_writer.readiness",
                                    ]
                                },
                                "periodSeconds": 5,
                                "timeoutSeconds": 3,
                            },
                        )
                    ],
                },
            },
        },
    },
]
print(json.dumps({"apiVersion": "v1", "kind": "List", "items": items}, indent=2))
